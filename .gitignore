# The desktop app's installed packages and compiled shell
desktop/node_modules/
desktop/out/

# Local Python tooling
__pycache__/
*.py[cod]
.venv
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets and machine-specific configuration
.env
.env.*
!.env.example
.DS_Store
HANDOFF.md
*.pem
*.key
*.p12
*.pfx

# Hearth runtime data and private content
.hearth/
data/
documents/
vault/
ocr/
indexes/
models/
runs/
artifacts/
logs/

# Local databases, model weights, and derived retrieval data
*.sqlite
*.sqlite-*
*.db
*.db-*
*.safetensors
*.gguf
*.onnx
*.mlmodel
*.mlpackage/

# Imported documents are private by default.
# Public or synthetic fixtures belong under tests/fixtures/public/ and may be explicitly unignored.
*.pdf
!tests/fixtures/public/
!tests/fixtures/public/**/*.pdf

# Markdown stays on this Mac for now, except the README, the command list, the reviewer guide Hearth reads from a task's base commit,
# and the public test fixtures the tests read.
*.md
!/README.md
!/docs/commands.md
!/docs/agents/review.md
!tests/fixtures/public/*.md

# Private question sets and relationship labels (knowledge track) stay on this Mac.
tests/fixtures/private/
